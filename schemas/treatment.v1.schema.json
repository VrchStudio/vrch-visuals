{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "filters": {
      "type": "object",
      "properties": {
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "brightness": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "contrast": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "saturate": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "hueRotate": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "invert": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sepia": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "blur": {
          "type": "number",
          "minimum": 0,
          "maximum": 50
        }
      },
      "required": []
    },
    "background": {
      "type": "string",
      "pattern": "^#[a-fA-F0-9]{6}$"
    },
    "blend": {
      "enum": [
        "normal",
        "multiply",
        "screen",
        "overlay",
        "darken",
        "lighten",
        "color-dodge",
        "color-burn",
        "hard-light",
        "soft-light",
        "difference",
        "exclusion",
        "hue",
        "saturation",
        "color",
        "luminosity"
      ]
    }
  },
  "required": [
    "schema_version"
  ]
}
