{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "params": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 4,
            "uniqueItems": true
          }
        },
        "required": [
          "label",
          "params"
        ]
      }
    },
    "simple": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 4,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version"
  ]
}
