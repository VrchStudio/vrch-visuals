{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VRCH Resource Descriptor (draft 0)",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "publisher",
    "name",
    "version",
    "tier",
    "license",
    "digest",
    "requires",
    "files",
    "provenance",
    "signatures"
  ],
  "properties": {
    "schema_version": {
      "const": 0
    },
    "kind": {
      "enum": [
        "app",
        "visual",
        "vibe"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "tier": {
      "enum": [
        "free",
        "premium"
      ]
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "object",
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "sha256",
            "jcs-sha256"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "requires": {
      "type": "object"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "sha256",
          "size"
        ],
        "anyOf": [
          {
            "required": [
              "path"
            ]
          },
          {
            "required": [
              "url"
            ]
          }
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "repository",
        "derived_from"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "digest"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "object",
                "required": [
                  "algorithm",
                  "value"
                ],
                "properties": {
                  "algorithm": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "signatures": {
      "type": "array"
    },
    "extensions": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "visual"
          }
        }
      },
      "then": {
        "properties": {
          "requires": {
            "type": "object",
            "required": [
              "abi",
              "stages",
              "sources",
              "signals",
              "analysis"
            ],
            "properties": {
              "abi": {
                "type": "string",
                "minLength": 1
              },
              "stages": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "main",
                    "frame",
                    "coarse"
                  ]
                }
              },
              "sources": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2
                }
              },
              "signals": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "analysis": {
                "type": "array",
                "items": {
                  "enum": [
                    "hand",
                    "face",
                    "pose"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
