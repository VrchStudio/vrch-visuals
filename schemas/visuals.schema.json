{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Official free visuals metadata (draft 0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "visuals"
  ],
  "properties": {
    "schema_version": {
      "const": 0
    },
    "visuals": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "publisher",
          "version",
          "tier",
          "license",
          "content_hash",
          "provenance",
          "thumbnails"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(vrch|user)\\.[a-z0-9][a-z0-9.-]*$"
          },
          "publisher": {
            "const": "vrch"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "tier": {
            "const": "free"
          },
          "license": {
            "const": "MIT"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "builtin",
                  "ai-derived",
                  "human-edit",
                  "migrated"
                ]
              }
            }
          },
          "thumbnails": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.-]+\\.(webp|png|jpg|jpeg)$"
            }
          }
        }
      }
    }
  }
}
