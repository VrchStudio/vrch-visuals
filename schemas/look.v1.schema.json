{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "params": {
      "type": "object"
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "modulation_master": {
      "type": "object"
    },
    "quality_mode": {
      "enum": [
        "auto",
        "edge",
        "standard",
        "high"
      ]
    }
  },
  "required": [
    "schema_version"
  ]
}
