{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "visual_id": {
      "type": "string",
      "pattern": "^(vrch|user|local)\\.[a-z0-9][a-z0-9.-]*$",
      "maxLength": 64
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "publisher": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "tier": {
      "enum": [
        "free",
        "premium"
      ]
    },
    "license": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "builtin",
            "migrated",
            "human-edit",
            "ai-derived"
          ]
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string"
              },
              "content_hash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "package_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "key"
            ]
          }
        }
      },
      "required": [
        "kind"
      ]
    },
    "thumbnails": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^/\\\\]+$"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "visual_id",
    "title",
    "description",
    "content_hash",
    "publisher",
    "version",
    "tier",
    "license",
    "provenance",
    "thumbnails"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "publisher": {
            "type": "string"
          }
        }
      },
      "then": {
        "properties": {
          "license": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          }
        }
      },
      "else": {
        "properties": {
          "version": {
            "type": "null"
          }
        }
      }
    }
  ]
}
